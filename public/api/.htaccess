# Zugangsdaten und Schema sind nie direkt abrufbar — auch dann nicht,
# wenn PHP mal aussteigt und .php-Dateien im Klartext ausgeliefert
# würden. Die eigentlichen Endpoints (calendar.php, weather.php)
# bleiben erreichbar.
#
# Unter nginx greift diese Datei nicht. Dort gehört ins server-Block:
#
#     location ~ ^/api/(config.*\.php|.*\.example|.*\.sql|\.env) {
#         deny all;
#     }

<FilesMatch "^(config\.php|config\.local.*|.*\.example|.*\.sql|\.env.*)$">
    # Apache 2.4
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    # Apache 2.2
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
